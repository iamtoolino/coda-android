  "motion": {
    "easing": {
      "emphasizedDecelerate": [
        0.05,
        0.7,
        0.1,
        1.0
      ],
      "emphasizedAccelerate": [
        0.3,
        0.0,
        0.8,
        0.15
      ],
      "standard": [
        0.2,
        0.0,
        0.0,
        1.0
      ],
      "standardDecelerate": [
        0.0,
        0.0,
        0.0,
        1.0
      ],
      "standardAccelerate": [
        0.3,
        0.0,
        1.0,
        1.0
      ],
      "linear": [
        0.0,
        0.0,
        1.0,
        1.0
      ]
    },
    "spring": {
      "settle": {
        "dampingRatio": 1.0,
        "stiffness": 500
      },
      "pager": {
        "dampingRatio": 1.0,
        "stiffness": 400
      },
      "fast": {
        "dampingRatio": 1.0,
        "stiffness": 1400
      }
    },
    "duration": {
      "short1": 50,
      "short2": 100,
      "short3": 150,
      "short4": 200,
      "medium1": 250,
      "medium2": 300,
      "medium3": 350,
      "medium4": 400,
      "long1": 450,
      "long2": 500
    },
    "transitions": {
      "miniToNowPlaying": {
        "ms": 450,
        "easing": "emphasizedDecelerate",
        "drag": "spring.settle",
        "shared": [
          "art:{coverArtId}",
          "player-container"
        ]
      },
      "nowPlayingToMini": {
        "ms": 350,
        "easing": "standard",
        "shared": [
          "art:{coverArtId}",
          "player-container"
        ]
      },
      "predictiveBackNowPlaying": {
        "scaleTo": 0.9,
        "shiftDp": 8,
        "cornerTo": 28,
        "commit": "nowPlayingToMini",
        "cancelMs": 200,
        "cancelEasing": "standardDecelerate"
      },
      "tileToAlbum": {
        "ms": 450,
        "easing": "emphasizedDecelerate",
        "shared": [
          "art:{coverArtId}"
        ]
      },
      "albumBack": {
        "ms": 350,
        "easing": "standard",
        "predictiveBack": {
          "scaleTo": 0.9,
          "cornerTo": 28
        }
      },
      "albumToNowPlaying": {
        "ms": 450,
        "easing": "emphasizedDecelerate",
        "shared": [
          "art:{coverArtId}",
          "play-button"
        ]
      },
      "accentCrossfade": {
        "ms": 450,
        "easing": "standard"
      },
      "backdropCrossfade": {
        "ms": 450,
        "easing": "standard"
      },
      "trackChangeTap": {
        "ms": 300,
        "easing": "emphasizedDecelerate",
        "sleeveShiftDp": 32,
        "textDriftDp": 6
      },
      "trackChangeSwipe": {
        "spring": "spring.pager"
      },
      "playPauseMorph": {
        "ms": 300,
        "easing": "standard",
        "iconMs": 200,
        "iconRotateDeg": 90
      },
      "sheetOpen": {
        "ms": 350,
        "easing": "emphasizedDecelerate"
      },
      "sheetClose": {
        "ms": 250,
        "easing": "emphasizedAccelerate"
      },
      "queueGroupExpand": {
        "ms": 300,
        "easing": "standard"
      },
      "rowLift": {
        "ms": 150,
        "easing": "standard"
      },
      "rowDrop": {
        "ms": 200,
        "easing": "standard"
      },
      "rowRemove": {
        "ms": 250,
        "easing": "standard"
      },
      "tabSwitch": {
        "outMs": 90,
        "inMs": 210,
        "easing": "standard",
        "scaleIn": 0.96
      },
      "bannerExpand": {
        "ms": 250,
        "easing": "standardDecelerate"
      },
      "contentFadeIn": {
        "ms": 150,
        "easing": "linear"
      },
      "pressFeedback": {
        "ms": 0,
        "note": "ripple starts on the down frame"
      }
    }
  }
}
