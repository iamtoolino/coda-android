        "accentContainer": "#193624",
        "surfaceTint": "#1C2C24",
        "page": "#1E442A",
        "contrast_accentText_on_page": 5.5,
        "contrast_onFill_on_fill": 3.4
      },
      "busy": {
        "accent": "#2F59AD",
        "kind": "chromatic",
        "accentText": "#8CB4FF",
        "fill": "#2F59AD",
        "onFill": "#FFFFFF",
        "accentContainer": "#14223D",
        "surfaceTint": "#192232",
        "page": "#18294B",
        "contrast_accentText_on_page": 6.9,
        "contrast_onFill_on_fill": 6.7
      },
      "typographic": {
        "accent": "#9B4C13",
        "kind": "chromatic",
        "accentText": "#F19D6C",
        "fill": "#9B4C13",
        "onFill": "#FFFFFF",
        "accentContainer": "#351E0F",
        "surfaceTint": "#2A1F19",
        "page": "#43240E",
        "contrast_accentText_on_page": 6.5,
        "contrast_onFill_on_fill": 6.1
      },
      "dark": {
        "accent": "#5E5D5D",
        "kind": "neutral",
        "accentText": "#B5B4B4",
        "fill": "#D8D7D7",
        "onFill": "#000000D1",
        "accentContainer": "#232425",
        "surfaceTint": "#212225",
        "page": "#2C2C2D",
        "contrast_accentText_on_page": 6.7,
        "contrast_onFill_on_fill": 14.6
      },
      "nearMono": {
        "accent": "#5C5F58",
        "kind": "neutral",
        "accentText": "#B2B6AE",
        "fill": "#D5D9D1",
        "onFill": "#000000D1",
        "accentContainer": "#222424",
        "surfaceTint": "#202324",
        "page": "#2B2D2B",
        "contrast_accentText_on_page": 6.7,
        "contrast_onFill_on_fill": 14.7
      },
      "warmGrey": {
        "accent": "#615D57",
        "kind": "tintedNeutral",
        "accentText": "#B8B3AD",
        "fill": "#DBD7D0",
        "onFill": "#000000D1",
        "accentContainer": "#232423",
        "surfaceTint": "#212224",
        "page": "#2D2C2A",
        "contrast_accentText_on_page": 6.7,
        "contrast_onFill_on_fill": 14.6
      },
      "noArtwork": {
