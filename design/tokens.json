{
  "$description": "Coda for Android design tokens (spec v1, gate G2: C3 Companion + C5 Full Bleed). dp/sp units. Colours are #RRGGBB or #RRGGBBAA. See design/spec.md.",
  "color": {
    "fixed": {
      "base": "#090B0D",
      "pageBase": "#08090A",
      "surface1": "#121417",
      "surface2": "#1A1C20",
      "surface3": "#22252A",
      "sheet": "#131518",
      "sheetTintBase": "#15171A",
      "outline": "#FFFFFF17",
      "hairline": "#FFFFFF0F",
      "text1": "#F1F1EE",
      "text2": "#F1F1EEA8",
      "text3": "#F1F1EE70",
      "disabledAlpha": 0.42,
      "brand": "#D19433",
      "onBrand": "#1A1206",
      "brandContainer": "#D1943324",
      "brandFallback": "#2B7A82",
      "danger": "#E5675E",
      "onDanger": "#2A0B08",
      "caution": "#F2C46B",
      "online": "#5BC27A",
      "offline": "#8A8A8A",
      "scrim": "#0000008F",
      "glassButton": "#0000005C",
      "tonal": "#FFFFFF17",
      "statusScrimTop": "#0000008C"
    },
    "derived": {
      "$input": "accent (ARGB) and kind (chromatic | tintedNeutral | neutral | fallback) from AccentRepository. Never re-sampled in the UI.",
      "accent": {
        "rule": "the precomputed accent, unchanged"
      },
      "onAccent": {
        "rule": "black at 82 % if relative luminance(accent) > 0.46, else white (ArtworkColor.contrastingColor)"
      },
      "accentText": {
        "rule": "same OKLCh hue, L = 0.77, C = min(C, 0.12), gamut-mapped by binary search on C"
      },
      "fill": {
        "rule": "chromatic/fallback: accent. neutral/tintedNeutral: same hue, L = 0.88, C = min(C, 0.10) (silver)"
      },
      "onFill": {
        "rule": "onAccent rule applied to fill"
      },
      "accentContainer": {
        "rule": "lerp(base #090B0D, accent, 0.30)"
      },
      "surfaceTint": {
        "rule": "lerp(#15171A, accent, 0.16)"
      },
      "page": {
        "rule": "lerp(#08090A, accent, 0.40); 0.42 for neutral/tintedNeutral"
      },
      "pageGradient": {
        "rule": "vertical: page at 0 dp, lerp(base, page, 0.55) at 520 dp, base #090B0D at 808 dp (scale stops by screenHeight/808)"
      },
      "glow": {
        "rule": "radial, accent at 30 % alpha, centre (0.20 w, 0) radius 0.9 w × 0.5 h, fading to 0 at 70 %"
      },
      "ratingBadge": {
        "rule": "accent at 35 % over #0E0E10 at 86 %"
      },
      "playingRow": {
        "rule": "background white 7 %, text and number in accentText"
      },
      "lerpSpace": "encoded sRGB channels (explicit interpolation; Compose lerp uses OKLab)"
    },
    "examples": {
      "vivid": {
        "accent": "#8B3D71",
        "kind": "chromatic",
        "accentText": "#E995C9",
        "fill": "#8B3D71",
        "onFill": "#FFFFFF",
        "accentContainer": "#301A2B",
        "surfaceTint": "#281D28",
        "page": "#3C1E33",
        "contrast_accentText_on_page": 6.7,
        "contrast_onFill_on_fill": 7.0
      },
      "pastel": {
