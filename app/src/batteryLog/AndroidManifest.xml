<?xml version="1.0" encoding="utf-8"?>
<!-- Merged only into debug and preview builds (app/build.gradle.kts); serves the battery log export to the share sheet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="dev.coda.android.diag.BatteryLogProvider"
            android:authorities="${applicationId}.batterylog"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
