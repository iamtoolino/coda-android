<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Coda only talks to the server the user enters,
         often over Tailscale (WireGuard-encrypted) or the LAN, so plain http is allowed. The login
         page shows an "Unencrypted connection" hint for http addresses. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
